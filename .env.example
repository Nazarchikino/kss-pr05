# Порт HTTP-сервера застосунку helpdesk-api
PORT=3000

# Профіль середовища виконання (development | test | production)
NODE_ENV=development

# Час життя токена доступу в хвилинах (для автентифікації у наступних роботах)
TOKEN_TTL_MIN=60

# Тип сховища заявок у пам'яті (memory – з початковими даними TICKETS_SEED, empty – порожнє сховище)
TICKETS_STORAGE=memory
